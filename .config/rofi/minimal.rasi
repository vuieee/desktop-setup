configuration {
  kb-cancel: "Escape,Super+Escape,Control+g";
}
configuration {
    drun-display-format: "{name}";
}

* {
    background-color: #1e222d;
    text-color: #f1f5f9;
    border-color: #f1f5f9;
    font: "MesloLGS Nerd Font 12";
}

window {
    width: 480px;
    border: 1px;
    border-radius: 6px;
    padding: 0px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 0px;
}

inputbar {
    children: [entry];
    padding: 12px 14px;
    border: 0px 0px 1px 0px;
}

entry {
    placeholder: "search";
    placeholder-color: #888888;
    text-color: #f1f5f9;
}

listview {
    lines: 8;
    padding: 8px 0px;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 14px;
    border-radius: 0px;
    background-color: #1e222d;
    text-color: #f1f5f9;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

element selected {
    background-color: #f1f5f9;
    text-color: #1e222d;
}
