configuration {
  kb-cancel: "Escape,Super+Escape,Control+g";
}
configuration {
    drun-display-format: "{name}";
}

* {
    background-color: transparent;
    text-color: #ffffff;
    border-color: #ffffff;
    font: "MesloLGS Nerd Font 12";
}

window {
    background-color: #000000b8;
    width: 480px;
    border: 2px;
    border-radius: 0px;
    padding: 0px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 0px;
}

inputbar {
    children: [entry];
    padding: 12px 14px;
    border: 0px 0px 2px 0px;
}

entry {
    placeholder: "search";
    placeholder-color: #888888;
    text-color: #ffffff;
}

listview {
    lines: 8;
    padding: 8px 0px;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 14px;
    border-radius: 0px;
    background-color: transparent;
    text-color: #ffffff;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

element selected {
    background-color: #ffffff;
    text-color: #000000;
}
