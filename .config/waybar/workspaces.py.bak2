#!/usr/bin/env python3
"""Waybar custom module: animated workspace strip (no bounce)."""
import glob
import json
import os
import select
import socket
import subprocess
import sys
import time

PERSISTENT = 5      # workspaces 1..N are always visible
FRAME = 0.016       # ~60 fps
VIS_SPEED = 0.20    # fade/width speed (higher = faster)
HL_SPEED = 0.30     # pill cross-fade speed
CHAR_PX = 7.8       # width of one character in px (JetBrains Mono at 13px)
LETTER_UNITS = int(CHAR_PX * 1024)  # Pango units per char width

COUNT_EVENTS = {
    "openwindow", "closewindow", "movewindow", "movewindowv2",
    "createworkspacev2", "destroyworkspacev2",
}


def event_socket_path():
    base = os.path.join(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "hypr"
    )
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        return os.path.join(base, sig, ".socket2.sock")
    dirs = sorted(glob.glob(os.path.join(base, "*")), key=os.path.getmtime)
    if not dirs:
        sys.exit(1)
    return os.path.join(dirs[-1], ".socket2.sock")


def hctl(*args):
    try:
        out = subprocess.run(
            ["hyprctl", "-j", *args], capture_output=True, text=True, timeout=2
        ).stdout
        return json.loads(out) if out.strip() else None
    except Exception:
        return None


def fetch_counts():
    """Workspace ids (>0) that currently hold at least one window."""
    workspaces = hctl("workspaces") or []
    return {
        w["id"] for w in workspaces
        if w.get("id", 0) > 0 and w.get("windows", 0) > 0
    }


def fetch_active():
    a = (hctl("activeworkspace") or {}).get("id")
    return a if isinstance(a, int) and a > 0 else None


def approach(cur, target, speed):
    d = target - cur
    if abs(d) < 0.005:
        return target
    step = d * speed
    if abs(step) < 0.005:
        step = 0.005 if d > 0 else -0.005
    return cur + step


class Strip:
    def __init__(self):
        self.counts = set()
        self.active = None
        self.vis = {}      # id -> 0..1 presence (opacity and width)
        self.hl = {}       # id -> 0..1 pill highlight
        self.started = False

    def target_ids(self):
        ids = set(range(1, PERSISTENT + 1)) | self.counts
        if self.active:
            ids.add(self.active)
        return ids

    def sync(self):
        for i in self.target_ids():
            if i not in self.vis:
                first = not self.started
                self.vis[i] = 1.0 if first else 0.0
                self.hl[i] = 1.0 if (first and i == self.active) else 0.0
        self.started = True

    def animating(self):
        ids = self.target_ids()
        for i in self.vis:
            if self.vis[i] != (1.0 if i in ids else 0.0):
                return True
            if self.hl.get(i, 0.0) != (1.0 if i == self.active else 0.0):
                return True
        return False

    def tick(self):
        ids = self.target_ids()
        for i in list(self.vis):
            tv = 1.0 if i in ids else 0.0
            th = 1.0 if i == self.active else 0.0
            self.vis[i] = approach(self.vis[i], tv, VIS_SPEED)
            self.hl[i] = approach(self.hl.get(i, 0.0), th, HL_SPEED)
            if tv == 0.0 and self.vis[i] <= 0.0 and self.hl[i] <= 0.0: