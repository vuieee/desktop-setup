{
  "layer": "bottom",
  "position": "top",
  "height": 30,
  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 0,
  "modules-left": [
    "custom/menu",
    "clock",
    "custom/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "tray",
    "custom/peripherals",
    "custom/caffeine",
    "battery",
    "wireplumber",
    "network",
    "bluetooth",
    "custom/power"
  ],
  "custom/menu": {
    "format": "\uf0c9",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/settings-menu.sh"
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "hyprland/window": {
    "format": "{class}",
    "separate-outputs": true
  },
  "battery": {
    "format": "{icon}",
    "format-charging": "\uf0e7",
    "format-plugged": "\uf1e6",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip-format": "{capacity}% | {timeTo}",
    "tooltip-format-plugged": "{capacity}% | Plugged",
    "tooltip-format-full": "{capacity}% | Full",
    "on-click": "python3 /home/mocha/.config/waybar/scripts/power-profile-menu.py"
  },
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "\uf026 MUTE",
    "format-icons": [
      "\uf026",
      "\uf027",
      "\uf028"
    ],
    "scroll-step": 5,
    "on-click": "kitty --class wiremix -e wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "bluetooth": {
    "format": "\uf294",
    "format-disabled": "\uf293",
    "format-off": "\uf293",
    "format-connected": "\uf294 {device_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "kitty --class bluetui -e bluetui",
    "on-click-right": "sh -c \"bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on\"",
    "tooltip-format": "On",
    "tooltip-format-off": "Off",
    "tooltip-format-disabled": "Off",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)"
  },
  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\udb80\ude00",
    "tooltip-format-ethernet": "{ifname} ({ipaddr})",
    "format-disconnected": "\uf127",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "on-click": "python3 /home/mocha/.config/power-menu/power-menu.py"
  },
  "custom/workspaces": {
    "exec": "python3 /home/mocha/.config/waybar/workspaces.py",
    "return-type": "json",
    "format": "{}",
    "tooltip": false
  },
  "width": 0,
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "custom/caffeine": {
    "exec": "python3 /home/mocha/.config/waybar/scripts/caffeine.py",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "python3 /home/mocha/.config/waybar/scripts/caffeine.py toggle"
  },
  "custom/peripherals": {
    "exec": "python3 /home/mocha/.config/waybar/scripts/peripherals.py",
    "return-type": "json",
    "interval": 15,
    "format": "{}"
  }
}
