* {
  font-family: "JetBrains Mono", monospace;
  font-size: 13px;
  border: none;
  border-radius: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
}

window#waybar {
  background: #000000;
  color: #ffffff;
  border-bottom: 1px solid #ffffff;
}

tooltip {
  background: #000000;
  border: 1px solid #ffffff;
  border-radius: 0;
}

tooltip label {
  color: #ffffff;
}

/* shared module padding */
#clock,
#tray,
#battery,
#wireplumber,
#bluetooth,
#backlight,
#network,
#custom-keys,
#custom-power {
  padding: 0 12px;
  color: #ffffff;
}

/* native hyprland/workspaces */
#workspaces {
  background: transparent;
  padding: 0 6px;
}

#workspaces button {
  padding: 0 8px;
  color: #808080;
  background: transparent;
  transition: background-color 0.16s ease, color 0.16s ease;
}

#workspaces button:hover {
  background: #333333;
  color: #ffffff;
  box-shadow: none;
  text-shadow: none;
}

#workspaces button.active {
  background: #ffffff;
  color: #000000;
}

#workspaces button.empty {
  color: #555555;
}

#workspaces button.empty.active {
  background: #ffffff;
  color: #000000;
}

#workspaces button.urgent {
  background: #808080;
  color: #000000;
}

/* tray (Steam, Discord, etc.) */
#tray > .passive {
  -gtk-icon-effect: dim;
}

#tray > .needs-attention {
  background: #ffffff;
}

/* states */
#battery.warning {
  color: #b0b0b0;
}

#battery.critical {
  background: #ffffff;
  color: #000000;
}

#wireplumber.muted,
#bluetooth.off,
#bluetooth.disabled,
#network.disconnected {
  color: #808080;
}

#custom-workspaces {
  padding: 0 12px;
}
