{
    "$schema": "https://github.com",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo/cachyos.png",
        "width": 28,
        "padding": {
            "top": 1,
            "right": 4,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": "default"
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": " ",
            "format": "\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[1msystem\u001b[22m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "\u2502                                         \u2502"
        },
        {
            "type": "os",
            "key": "\u2502  \u001b[36mOS\u001b[39m           ",
            "format": "{pretty-name>22}  \u2502"
        },
        {
            "type": "command",
            "key": "\u2502  \u001b[36mKernel\u001b[39m       ",
            "text": "uname -r | cut -d '-' -f1",
            "format": "{result>22}  \u2502"
        },
        {
            "type": "shell",
            "key": "\u2502  \u001b[36mShell\u001b[39m        ",
            "format": "{pretty-name>22}  \u2502"
        },
        {
            "type": "command",
            "key": "\u2502  \u001b[36mWM\u001b[39m           ",
            "text": "echo $XDG_CURRENT_DESKTOP",
            "format": "{result>22}  \u2502"
        },
        {
            "type": "command",
            "key": "\u2502  \u001b[36mRam\u001b[39m          ",
            "text": "free -m | awk 'NR==2{printf \"%.2f / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{result>22}  \u2502"
        },
        {
            "type": "command",
            "key": "\u2502  \u001b[36mCPU\u001b[39m          ",
            "text": "awk -F: '/model name/{match($2,/i[0-9]-[0-9A-Za-z]+/); print substr($2,RSTART,RLENGTH); exit}' /proc/cpuinfo",
            "format": "{result>22}  \u2502"
        },
        {
            "type": "command",
            "key": "\u2502  \u001b[36mGPU\u001b[39m          ",
            "text": "fastfetch -s gpu --format json | python3 -c \"import sys,json; gs=[g['name'] for g in json.load(sys.stdin)[0]['result']]; g=next((x for x in gs if 'NVIDIA' in x or 'AMD' in x or 'Radeon' in x), gs[0] if gs else 'Unknown'); print(g.replace('NVIDIA GeForce ','').replace('Intel ','')[:22])\"",
            "format": "{result>22}  \u2502"
        },
        {
            "type": "disk",
            "key": "\u2502  \u001b[36mDisk1\u001b[39m        ",
            "folders": "/",
            "format": "{size-used>9} / {size-total>10}  \u2502"
        },
        {
            "type": "disk",
            "key": "\u2502  \u001b[36mDisk2\u001b[39m        ",
            "folders": "/mnt/2tb",
            "format": "{size-used>9} / {size-total>10}  \u2502"
        },
        {
            "type": "packages",
            "key": "\u2502  \u001b[36mPackages\u001b[39m     ",
            "format": "{all>22}  \u2502"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "\u2502                                         \u2502"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "\u2570\u2500\u2500\u2500 \u001b[1;33mBLAZINGLY FAST !\u001b[22;39m \u2500\u2500 \u001b[1;31m\u5727\u5012\u7684\u7206\u901f\uff01\u001b[22;39m \u2500\u2500\u2500\u2500\u256f"
        },
        "break"
    ]
}
